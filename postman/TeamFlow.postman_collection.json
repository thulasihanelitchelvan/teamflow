          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo-user@example.test\",\n  \"password\": \"ReplaceWithLongPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
